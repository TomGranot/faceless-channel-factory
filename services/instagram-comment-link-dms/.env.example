# Offline fixtures are the default. They make no provider requests.
MODE=fixture
WRITE_MODE=disabled

CHANNELS_FILE=config/channels.local.json
STATE_FILE=data/state.json
FIXTURE_POSTS_FILE=fixtures/postiz-posts.json
FIXTURE_COMMENTS_FILE=fixtures/instagram-comments.json

POSTIZ_API_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=
POSTIZ_LOOKBACK_DAYS=120
INSTAGRAM_GRAPH_URL=https://graph.instagram.com/v25.0
MAX_COMMENTS_PER_POST=500
MAX_WRITES_PER_RUN=10

# Live private replies require all three controls.
LIVE_CONFIRMATION=
LIVE_UNLOCK_FILE=

# Tokens are referenced by name from channels.local.json.
CHANNEL_A_INSTAGRAM_ACCESS_TOKEN=
CHANNEL_B_INSTAGRAM_ACCESS_TOKEN=
