<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.instagram-comment-link-dms</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__SERVICE_DIR__/scripts/run-from-env.zsh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__SERVICE_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>INSTAGRAM_COMMENT_DM_ENV</key>
    <string>__SERVICE_DIR__/.env.local</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/tmp/instagram-comment-link-dms.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/instagram-comment-link-dms.error.log</string>
</dict>
</plist>
